---
// Elegant subcategory navigation component

import { getPostsByCategory } from '../utils/content';

interface Props {
  category: string;
  currentSubcategory?: string;
}

const { category, currentSubcategory } = Astro.props;

// Get all posts in this category
const posts = await getPostsByCategory(category);

// Get unique subcategories with count
const subcategoryMap = new Map<string, number>();
posts.forEach(post => {
  if (post.data.subcategory) {
    subcategoryMap.set(
      post.data.subcategory,
      (subcategoryMap.get(post.data.subcategory) || 0) + 1
    );
  }
});

// Sort by count (descending)
const subcategories = Array.from(subcategoryMap.entries())
  .sort((a, b) => b[1] - a[1]);

const categorySlug = category.toLowerCase().replace(/\s+/g, '-');
---

<nav class="subcategory-nav">
  <div class="nav-header">
    <h3 class="nav-title">Browse by topic</h3>
  </div>
  
  <ul class="nav-list">
    <li>
      <a 
        href={`/${categorySlug}/`}
        class={`nav-link ${!currentSubcategory ? 'active' : ''}`}
      >
        <span class="link-text">All topics</span>
        <span class="link-count">{posts.length}</span>
      </a>
    </li>
    {subcategories.map(([subcategory, count]) => (
      <li>
        <a 
          href={`/${categorySlug}/#${subcategory.toLowerCase().replace(/\s+/g, '-')}`}
          class={`nav-link ${currentSubcategory === subcategory ? 'active' : ''}`}
        >
          <span class="link-text">{subcategory}</span>
          <span class="link-count">{count}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .subcategory-nav {
    margin-bottom: 3rem;
  }

  .nav-header {
    margin-bottom: 1rem;
  }

  .nav-title {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-light, #6b7280);
    margin: 0;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border, #e5e7eb);
  }

  .nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 0.75rem;
  }

  .nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    background: var(--color-bg-light, #f9fafb);
    color: var(--color-text, #1f2937);
    text-decoration: none;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 500;
    border: 1px solid var(--color-border, #e5e7eb);
    transition: all 0.2s ease;
  }

  .nav-link:hover {
    background: var(--color-primary-light, #dbeafe);
    color: var(--color-primary, #3b82f6);
    border-color: var(--color-primary, #3b82f6);
    transform: translateY(-2px);
  }

  .nav-link.active {
    background: var(--color-primary, #3b82f6);
    color: white;
    border-color: var(--color-primary, #3b82f6);
  }

  .link-text {
    flex: 1;
    text-align: left;
  }

  .link-count {
    font-size: 0.75rem;
    font-weight: 600;
    opacity: 0.7;
    margin-left: 0.5rem;
  }

  .nav-link.active .link-count {
    opacity: 0.9;
  }

  /* Dark Mode */
  :global(.dark) .nav-title {
    color: var(--color-text-light, #9ca3af);
    border-bottom-color: var(--color-border, #374151);
  }

  :global(.dark) .nav-link {
    background: rgba(107, 114, 128, 0.1);
    color: var(--color-text, #e5e7eb);
    border-color: var(--color-border, #374151);
  }

  :global(.dark) .nav-link:hover {
    background: rgba(59, 130, 246, 0.2);
    color: #60a5fa;
    border-color: rgba(96, 165, 250, 0.5);
  }

  :global(.dark) .nav-link.active {
    background: var(--color-primary, #3b82f6);
    color: white;
    border-color: var(--color-primary, #3b82f6);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .nav-list {
      grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    }
  }

  @media (max-width: 768px) {
    .nav-list {
      grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
      gap: 0.5rem;
    }

    .nav-link {
      padding: 0.6rem 0.8rem;
      font-size: 0.85rem;
    }
  }

  @media (max-width: 480px) {
    .nav-list {
      grid-template-columns: 1fr;
    }
  }
</style>
