---
// Elegant sidebar component for post pages

import { getAllTags, getFeaturedPosts } from '../utils/content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  currentSlug?: string;
  relatedPosts?: CollectionEntry<'blog'>[];
  category?: string;
  tags?: string[];
}

const { currentSlug, relatedPosts = [], category, tags = [] } = Astro.props;

// Get featured/popular posts
const featuredPosts = await getFeaturedPosts(5);

// Get all tags for tag cloud
const allTags = await getAllTags();
const topTags = allTags.slice(0, 6);

// Filter featured posts to exclude current post
const sidebarFeaturedPosts = featuredPosts
  .filter(p => p.slug !== currentSlug)
  .slice(0, 3);
---

<aside class="sidebar">
  <!-- Popular Articles -->
  {sidebarFeaturedPosts.length > 0 && (
    <section class="sidebar-block">
      <h3 class="block-title">Popular</h3>
      <ul class="articles">
        {sidebarFeaturedPosts.map((post, idx) => (
          <li class="article-item">
            <a href={`/blog/${post.slug}/`} class="article-title">
              <span class="number">{idx + 1}</span>
              {post.data.title}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- Related Articles -->
  {relatedPosts && relatedPosts.length > 0 && (
    <section class="sidebar-block">
      <h3 class="block-title">Related</h3>
      <ul class="articles">
        {relatedPosts.map((post) => (
          <li class="article-item">
            <a href={`/blog/${post.slug}/`} class="article-link">
              {post.data.title}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- Tags -->
  {topTags.length > 0 && (
    <section class="sidebar-block">
      <h3 class="block-title">Topics</h3>
      <div class="tags">
        {topTags.map(([tag, count]) => (
          <a href={`/tags/${tag}/`} class="tag" title={`${count} articles`}>
            {tag}
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Category -->
  {category && (
    <section class="sidebar-block">
      <h3 class="block-title">Category</h3>
      <a href={`/${category.toLowerCase().replace(/\s+/g, '-')}/`} class="category-link">
        {category}
        <span class="arrow">→</span>
      </a>
    </section>
  )}
</aside>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    position: sticky;
    top: 100px;
  }

  .sidebar-block {
    animation: fadeIn 0.5s ease-out;
  }

  .block-title {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-light, #6b7280);
    margin: 0 0 1rem 0;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border, #e5e7eb);
  }

  /* Articles List */
  .articles {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .article-item {
    margin: 0;
  }

  .article-title {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--color-text, #1f2937);
    font-size: 0.9rem;
    line-height: 1.5;
    transition: all 0.2s ease;
    font-weight: 500;
  }

  .article-title:hover {
    color: var(--color-primary, #3b82f6);
    transform: translateX(4px);
  }

  .number {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    background: var(--color-primary-light, #dbeafe);
    color: var(--color-primary, #3b82f6);
    border-radius: 50%;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .article-link {
    display: block;
    text-decoration: none;
    color: var(--color-text, #1f2937);
    font-size: 0.9rem;
    line-height: 1.5;
    transition: all 0.2s ease;
    padding: 0.5rem;
    border-left: 2px solid transparent;
    padding-left: 0.75rem;
  }

  .article-link:hover {
    color: var(--color-primary, #3b82f6);
    border-left-color: var(--color-primary, #3b82f6);
    background: var(--color-primary-light, #f0f9ff);
  }

  /* Tags */
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.8rem;
    background: var(--color-bg-light, #f9fafb);
    color: var(--color-text, #1f2937);
    text-decoration: none;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 500;
    border: 1px solid var(--color-border, #e5e7eb);
    transition: all 0.2s ease;
  }

  .tag:hover {
    background: var(--color-primary, #3b82f6);
    color: white;
    border-color: var(--color-primary, #3b82f6);
    transform: translateY(-1px);
  }

  /* Category Link */
  .category-link {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    text-decoration: none;
    color: var(--color-primary, #3b82f6);
    font-size: 0.95rem;
    font-weight: 500;
    padding: 0.75rem 1rem;
    background: var(--color-primary-light, #f0f9ff);
    border-radius: 6px;
    border: 1px solid var(--color-primary, #3b82f6);
    transition: all 0.2s ease;
    width: 100%;
  }

  .category-link:hover {
    background: var(--color-primary, #3b82f6);
    color: white;
    transform: translateX(4px);
  }

  .arrow {
    opacity: 0.6;
    transition: all 0.2s ease;
  }

  .category-link:hover .arrow {
    opacity: 1;
    transform: translateX(4px);
  }

  /* Dark Mode */
  :global(.dark) .block-title {
    color: var(--color-text-light, #9ca3af);
    border-bottom-color: var(--color-border, #374151);
  }

  :global(.dark) .article-title {
    color: var(--color-text, #e5e7eb);
  }

  :global(.dark) .article-title:hover {
    color: #60a5fa;
  }

  :global(.dark) .number {
    background: rgba(96, 165, 250, 0.1);
    color: #60a5fa;
  }

  :global(.dark) .article-link {
    color: var(--color-text, #e5e7eb);
  }

  :global(.dark) .article-link:hover {
    color: #60a5fa;
    border-left-color: #60a5fa;
    background: rgba(96, 165, 250, 0.1);
  }

  :global(.dark) .tag {
    background: rgba(107, 114, 128, 0.2);
    color: var(--color-text, #e5e7eb);
    border-color: var(--color-border, #374151);
  }

  :global(.dark) .tag:hover {
    background: #3b82f6;
    border-color: #3b82f6;
    color: white;
  }

  :global(.dark) .category-link {
    background: rgba(59, 130, 246, 0.1);
    color: #60a5fa;
    border-color: rgba(96, 165, 250, 0.3);
  }

  :global(.dark) .category-link:hover {
    background: #3b82f6;
    color: white;
    border-color: #3b82f6;
  }

  /* Animations */
  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .sidebar {
      position: relative;
      top: 0;
      gap: 1.5rem;
    }
  }

  @media (max-width: 768px) {
    .sidebar {
      gap: 1.5rem;
    }

    .sidebar-block {
      display: none;
    }

    .sidebar-block:first-child {
      display: block;
    }
  }
</style>
