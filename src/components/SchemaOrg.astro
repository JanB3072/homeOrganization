---
// Schema.org structured data generator
// Supports WebSite, BlogPosting, CollectionPage, and Organization schemas

export interface Props {
  type: 'Organization' | 'BlogPosting' | 'CollectionPage' | 'WebSite';
  title?: string;
  description?: string;
  image?: string;
  datePublished?: Date;
  dateModified?: Date;
  author?: string;
  url?: string;
  category?: string;
  tags?: string[];
}

const {
  type,
  title,
  description,
  image = '/og-image-default.jpg',
  datePublished,
  dateModified,
  author = 'Your Name',
  url = Astro.url.href,
  category,
  tags = [],
} = Astro.props;

// Generate schema based on type
let schema: any = {};

if (type === 'WebSite') {
  schema = {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Home Organization Blog',
    url: url,
    description: description || 'Real home organization solutions with measurements and photos',
    inLanguage: ['en', 'zh'],
    creator: {
      '@type': 'Organization',
      name: 'Home Organization Blog',
    },
    potentialAction: {
      '@type': 'SearchAction',
      target: `${url}?s={search_term_string}`,
      'query-input': 'required name=search_term_string',
    },
  };
}

if (type === 'BlogPosting') {
  const keywords = tags && tags.length > 0 ? tags.join(', ') : category || '';
  
  schema = {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description: description,
    image: image,
    datePublished: datePublished?.toISOString(),
    dateModified: dateModified?.toISOString() || datePublished?.toISOString(),
    author: {
      '@type': 'Person',
      name: author,
    },
    publisher: {
      '@type': 'Organization',
      name: 'Home Organization Blog',
      logo: {
        '@type': 'ImageObject',
        url: `${url.split('/').slice(0, 3).join('/')}/logo.png`,
      },
    },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': url,
    },
    keywords: keywords,
    articleSection: category,
  };
}

if (type === 'CollectionPage') {
  schema = {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description: description,
    url: url,
    image: image,
    inLanguage: 'en',
  };
}

if (type === 'Organization') {
  schema = {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Home Organization Blog',
    url: url,
    description: description,
    logo: `${url.split('/').slice(0, 3).join('/')}/logo.png`,
    sameAs: [
      'https://www.pinterest.com/yourusername',
      'https://www.instagram.com/yourusername',
    ],
  };
}
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
