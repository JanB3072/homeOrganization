---
// Schema.org structured data generator
// Supports WebSite, BlogPosting, CollectionPage, Organization, and FAQPage schemas
// GEO note: FAQPage + explicit key data help generative engines (ChatGPT/Perplexity/Gemini) cite this content.

export interface Props {
  type: 'Organization' | 'BlogPosting' | 'CollectionPage' | 'WebSite';
  title?: string;
  description?: string;
  image?: string;
  datePublished?: Date;
  dateModified?: Date;
  author?: string;
  body?: string;
  url?: string;
  category?: string;
  tags?: string[];
  faq?: Array<{ question: string; answer: string }>;
  howTo?: Array<{ name: string; text: string }>;
}

const {
  type,
  title,
  description,
  image = '/og-image-default.jpg',
  datePublished,
  dateModified,
  author = "Clara",
  body,
  url = Astro.url.href,
  category,
  tags = [],
  faq = [],
  howTo = [],
} = Astro.props;

const wordCount = body
  ? body.trim().split(/\s+/).filter(Boolean).length
  : undefined;

// Resolve image to an absolute URL so crawlers and AI engines don't guess the domain.
const absoluteImage = (() => {
  try {
    return new URL(image, Astro.site ?? Astro.url.origin).href;
  } catch {
    return image;
  }
})();

const siteOrigin = Astro.site?.href ?? Astro.url.origin;

// Generate schema based on type
let schema: any = {};

if (type === 'WebSite') {
  schema = {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Organizing Small',
    url: siteOrigin,
    description: description || 'Real home organization solutions with measurements and photos',
    inLanguage: 'en',
    creator: {
      '@type': 'Organization',
      name: 'Organizing Small',
    },
    potentialAction: {
      '@type': 'SearchAction',
      target: `${siteOrigin}search/?s={search_term_string}`,
      'query-input': 'required name=search_term_string',
    },
  };
}

if (type === 'BlogPosting') {
  const keywords = tags && tags.length > 0 ? tags.join(', ') : category || '';
  
  schema = {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description: description,
    image: absoluteImage,
    datePublished: datePublished?.toISOString(),
    dateModified: dateModified?.toISOString() || datePublished?.toISOString(),
    inLanguage: 'en',
    author: {
      '@type': 'Person',
      name: author,
      url: `${siteOrigin}about/`,
    },
    publisher: {
      '@type': 'Organization',
      name: 'Organizing Small',
      logo: {
        '@type': 'ImageObject',
        url: `${siteOrigin}logo.png`,
      },
    },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': url,
    },
    keywords: keywords,
    articleSection: category,
    articleBody: body,
    wordCount: wordCount,
  };
}

if (type === 'CollectionPage') {
  schema = {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description: description,
    url: url,
    image: absoluteImage,
    inLanguage: 'en',
  };
}

if (type === 'Organization') {
  schema = {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Organizing Small',
    url: url,
    description: description,
    logo: `${siteOrigin}logo.png`,
  };
}

// Separate FAQPage schema (rendered as its own JSON-LD block).
const faqSchema = faq && faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer,
    },
  })),
} : null;

// Separate HowTo schema (for step-by-step guides; helps rich results + AI citations).
const howToSchema = howTo && howTo.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: title,
  description: description,
  step: howTo.map((s, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: s.name,
    text: s.text,
  })),
} : null;
---

{([schema, faqSchema, howToSchema].filter(Boolean).map((block) => (
  <script type="application/ld+json" set:html={JSON.stringify(block)} />
)))}
