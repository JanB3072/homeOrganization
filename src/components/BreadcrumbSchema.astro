---
// Breadcrumb Navigation with Structured Data

interface Props {
  items?: Array<{
    label: string;
    url: string;
  }>;
}

const { items = [] } = Astro.props;

// Auto-generate breadcrumbs from URL if not provided
const pathname = Astro.url.pathname;
const pathSegments = pathname.split('/').filter(seg => seg);

// Map URL segments to readable labels and URLs
const categoryMap: Record<string, string> = {
  'kitchen': 'Kitchen',
  'closet': 'Closet',
  'bathroom': 'Bathroom',
  'small-space': 'Small Space',
  'declutter': 'Declutter',
  'blog': 'Blog',
  'tags': 'Tags',
  'archive': 'Archive',
  'popular': 'Popular',
  'search': 'Search',
  'about': 'About',
  'privacy': 'Privacy',
  'affiliate-disclosure': 'Affiliate Disclosure',
};

// Build breadcrumbs
let breadcrumbs = [{ label: 'Home', url: '/' }];

if (items && items.length > 0) {
  // Use provided items
  breadcrumbs = [breadcrumbs[0], ...items];
} else if (pathSegments.length > 0) {
  // Auto-generate from URL
  let currentUrl = '';
  
  for (const segment of pathSegments) {
    currentUrl += `/${segment}`;
    
    // Skip numeric segments (pagination)
    if (/^\d+$/.test(segment)) {
      breadcrumbs[breadcrumbs.length - 1].url = currentUrl;
      continue;
    }
    
    const label = categoryMap[segment] || segment
      .replace(/-/g, ' ')
      .split(' ')
      .map((word: string) => word.charAt(0).toUpperCase() + word.slice(1))
      .join(' ');
    
    breadcrumbs.push({ label, url: currentUrl });
  }
}

// Generate Schema.org structured data
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    item: `${Astro.url.origin}${item.url}`,
  })),
};
---

<!-- Breadcrumb Navigation -->
<nav aria-label="Breadcrumb" class="breadcrumb-nav">
  <ol class="breadcrumb-list">
    {breadcrumbs.map((item, index) => (
      <li class="breadcrumb-item" key={index}>
        {index < breadcrumbs.length - 1 ? (
          <>
            <a href={item.url} class="breadcrumb-link">{item.label}</a>
            <span class="breadcrumb-separator">/</span>
          </>
        ) : (
          <span class="breadcrumb-current" aria-current="page">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>

<!-- Schema.org JSON-LD -->
<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<style>
  .breadcrumb-nav {
    margin: 1.5rem 0;
    padding: 1rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .breadcrumb-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 0.5rem;
  }

  .breadcrumb-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
  }

  .breadcrumb-link {
    color: var(--color-primary);
    text-decoration: none;
    transition: all 0.3s ease;
    font-weight: 500;
  }

  .breadcrumb-link:hover {
    color: var(--color-primary-dark);
    text-decoration: underline;
  }

  .breadcrumb-link:focus {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .breadcrumb-separator {
    color: var(--color-border);
    margin: 0 0.25rem;
  }

  .breadcrumb-current {
    color: var(--color-text);
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .breadcrumb-nav {
      margin: 1rem 0;
      padding: 0.75rem 0;
    }

    .breadcrumb-item {
      font-size: 0.85rem;
    }

    .breadcrumb-separator {
      margin: 0 0.15rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .breadcrumb-link {
      transition: none;
    }
  }
</style>
