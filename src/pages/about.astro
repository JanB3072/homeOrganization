---
// 关于我 页面

import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About Me" description="关于我和这个博客">
  <h1>关于我</h1>
  
  <section>
    <h2>我是谁</h2>
    <p>填写你的个人介绍，包括：</p>
    <ul>
      <li>你的真实姓名</li>
      <li>你住在哪里（城市）</li>
      <li>你的家有多大</li>
      <li>家庭成员情况</li>
      <li>为什么开始写这个博客</li>
    </ul>
  </section>

  <section>
    <h2>这个博客的故事</h2>
    <p>分享为什么你决定开始记录自己的收纳经历...</p>
  </section>

  <section>
    <h2>联系我</h2>
    <p>Email: <a href="mailto:your-email@example.com">your-email@example.com</a></p>
  </section>
</BaseLayout>
