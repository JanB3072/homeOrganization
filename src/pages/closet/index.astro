---
// Closet & Bedroom category page

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPostsByCategory } from '../../utils/content';

const closetPosts = await getPostsByCategory('Closet');

const subcategories = [
  { 
    name: 'Closet Organization', 
    slug: 'closet', 
    icon: '👔',
    description: 'Hanging rods, shelving, seasonal rotation, and folding methods' 
  },
  { 
    name: 'Bedroom & Under-Bed', 
    slug: 'bedroom', 
    icon: '🛏️',
    description: 'Under-bed storage, dressers, and bedside solutions' 
  }
];
---

<BaseLayout 
  title="Closet & Bedroom Organization - Storage Ideas" 
  description="Closet organization ideas: complete closet breakdown, under-bed storage, and bedroom space utilization. Real measurements and before-and-after photos."
>
  <!-- Hero Section -->
  <section style="margin-bottom: 3rem;">
    <div style="background: linear-gradient(135deg, #e9d5ff 0%, #fce7f3 100%); padding: 3rem 2rem; border-radius: 1rem; text-align: center;">
      <h1 style="color: #6b21a8; margin-bottom: 1rem;">👕 Closet & Bedroom</h1>
      <p style="color: #9333ea; font-size: 1.1rem; max-width: 600px; margin: 0 auto; line-height: 1.8;">
        A well-organized closet looks neat but falls apart easily. Here's my complete closet breakdown plus how I maximize under-bed storage.
      </p>
    </div>
  </section>

  <!-- Subcategories Grid -->
  <section style="margin-bottom: 4rem;">
    <h2 style="text-align: center; margin-bottom: 2.5rem; font-size: 1.8rem;">Organize Your Space</h2>
    
    <div style="
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 2rem;
    ">
      {subcategories.map((sub) => (
        <a 
          href={`/closet/${sub.slug}/`}
          style="
            display: block;
            padding: 2rem;
            background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
            border: 2px solid var(--color-border);
            border-radius: 1rem;
            text-decoration: none;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
          "
          onmouseenter="this.style.borderColor='#a855f7'; this.style.transform='translateY(-6px)'; this.style.boxShadow='0 20px 25px -5px rgba(0, 0, 0, 0.1)';"
          onmouseleave="this.style.borderColor='var(--color-border)'; this.style.transform='translateY(0)'; this.style.boxShadow='0 1px 2px 0 rgba(0, 0, 0, 0.05)';"
        >
          <div style="font-size: 2.5rem; margin-bottom: 1rem;">{sub.icon}</div>
          <h3 style="color: var(--color-text); margin: 0.5rem 0; font-size: 1.2rem;">{sub.name}</h3>
          <p style="color: var(--color-text-light); margin: 0; font-size: 0.95rem; line-height: 1.5;">
            {sub.description}
          </p>
        </a>
      ))}
    </div>
  </section>

  <!-- Info Section -->
  <section style="
    background: linear-gradient(135deg, #fce7f3 0%, #e9d5ff 100%);
    padding: 3rem 2rem;
    border-radius: 1rem;
    border-left: 4px solid #ec4899;
    margin-bottom: 3rem;
  ">
    <h2 style="color: #9333ea; margin-top: 0; font-size: 1.5rem;">💡 Closet & Bedroom Tips</h2>
    <ul style="color: var(--color-text-light); line-height: 1.8;">
      <li>Use vertical space - double hanging rods maximize capacity</li>
      <li>Color coding - group by color for faster outfit selection</li>
      <li>Measure dimensions - know your rod heights and shelf depths</li>
      <li>Seasonal rotation - store out-of-season items under the bed</li>
      <li>Under-bed containers - choose ones that fit your bed height</li>
    </ul>
  </section>

  <!-- Articles -->
  <section>
    <h2 style="margin-bottom: 2rem;">📝 Latest Articles</h2>
    {closetPosts.length > 0 ? (
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem;">
        {closetPosts.map(post => (
          <article style="
            padding: 1.5rem;
            background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
            border: 1px solid var(--color-border);
            border-radius: 0.75rem;
            transition: all 0.3s ease;
          "
          onmouseenter="this.style.borderColor='var(--color-primary)'; this.style.boxShadow='0 10px 15px -3px rgba(0, 0, 0, 0.1)';"
          onmouseleave="this.style.borderColor='var(--color-border)'; this.style.boxShadow='0 1px 2px 0 rgba(0, 0, 0, 0.05)';">
            <a href={`/blog/${post.slug}/`} style="text-decoration: none; color: inherit;">
              <h3 style="margin: 0 0 0.5rem 0; color: var(--color-text);">{post.data.title}</h3>
            </a>
            <p style="color: var(--color-text-light); margin: 0.5rem 0 1rem 0; line-height: 1.6;">
              {post.data.description}
            </p>
            <div style="display: flex; gap: 1.5rem; font-size: 0.9rem; color: var(--color-text-light);">
              <span>📅 {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
              <a href={`/blog/${post.slug}/`} style="color: var(--color-primary); text-decoration: none; margin-left: auto;">
                Read More →
              </a>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div style="
        padding: 3rem 2rem;
        text-align: center;
        background: var(--color-bg-light);
        border-radius: 1rem;
        border: 2px dashed var(--color-border);
      ">
        <p style="margin: 0; color: var(--color-text-light); font-size: 1.05rem;">
          No Closet articles yet. Check back soon!
        </p>
      </div>
    )}
  </section>
</BaseLayout>
