---
// 衣柜与卧室分类页

import BaseLayout from '../../layouts/BaseLayout.astro';

const subcategories = [
  { name: 'Closet', slug: 'closet', description: '挂杆高度、层板、换季、折叠' },
  { name: 'Bedroom & Under-Bed', slug: 'bedroom', description: '床下、斗柜、床头收纳' }
];
---

<BaseLayout title="Closet & Bedroom - 衣柜与卧室收纳" description="衣柜与卧室收纳方案：衣柜拆解、床下收纳、卧室空间利用">
  <h1>衣柜与卧室 Closet & Bedroom</h1>
  <p>衣柜是最容易"看起来整洁"的地方，也是最容易反复崩溃的地方。这里记录我对衣柜的完整改造和床下的充分利用。</p>

  <section class="subcategories">
    <h2>子分类</h2>
    <div class="subcategory-grid">
      {subcategories.map(sub => (
        <div class="subcategory-card">
          <h3><a href={`/closet/${sub.slug}/`}>{sub.name}</a></h3>
          <p>{sub.description}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="articles">
    <h2>最新文章</h2>
    <p>敬请期待...</p>
  </section>

  <style>
    .subcategories {
      margin: 2rem 0;
    }

    .subcategory-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1.5rem;
      margin: 1.5rem 0;
    }

    .subcategory-card {
      border: 1px solid #eee;
      padding: 1.5rem;
      border-radius: 8px;
    }

    .subcategory-card h3 {
      margin-top: 0;
    }

    .subcategory-card a {
      text-decoration: none;
    }
  </style>
</BaseLayout>
