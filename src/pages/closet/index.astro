---
// Closet & Bedroom category page

import BaseLayout from '../../layouts/BaseLayout.astro';

const subcategories = [
  { name: 'Closet Organization', slug: 'closet', description: 'Hanging rods, shelving, seasonal rotation, and folding methods' },
  { name: 'Bedroom & Under-Bed', slug: 'bedroom', description: 'Under-bed storage, dressers, and bedside solutions' }
];
---

<BaseLayout title="Closet & Bedroom Organization - Storage Ideas" description="Closet organization ideas: complete closet breakdown, under-bed storage, and bedroom space utilization. Real measurements and before-and-after photos.">
  <h1>Closet & Bedroom Organization</h1>
  <p>A well-organized closet looks neat but falls apart easily. Here's my complete closet breakdown plus how I maximize under-bed storage.</p>

  <section class="subcategories">
    <h2>Categories</h2>
    <div class="subcategory-grid">
      {subcategories.map(sub => (
        <div class="subcategory-card">
          <h3><a href={`/closet/${sub.slug}/`}>{sub.name}</a></h3>
          <p>{sub.description}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="articles">
    <h2>Latest Articles</h2>
    <p>Coming soon...</p>
  </section>

  <style>
    .subcategories {
      margin: 2rem 0;
    }

    .subcategory-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1.5rem;
      margin: 1.5rem 0;
    }

    .subcategory-card {
      border: 1px solid #eee;
      padding: 1.5rem;
      border-radius: 8px;
    }

    .subcategory-card h3 {
      margin-top: 0;
    }

    .subcategory-card a {
      text-decoration: none;
    }
  </style>
</BaseLayout>
