---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Pagination from '../../components/Pagination.astro';
import SubcategoryNav from '../../components/SubcategoryNav.astro';
import { getCategoryPaginated } from '../../utils/content';

interface Props {
  params: {
    page: string;
  };
}

const page = parseInt(Astro.params.page || '1', 10);
const perPage = 12;

// Get all closet posts
const data = await getCategoryPaginated('Closet', page, perPage);

// Validate page number
if (page < 1 || page > data.totalPages) {
  return Astro.redirect('/closet/');
}

// Generate static paths
export async function getStaticPaths() {
  const closetData = await getCategoryPaginated('Closet', 1);
  return Array.from({ length: Math.max(0, closetData.totalPages - 1) }, (_, i) => ({
    params: { page: String(i + 2) },
  }));
}

// SEO metadata
const title = page === 1 
  ? 'Closet & Bedroom Organization | Organizing Small'
  : `Closet Organization - Page ${page} | Organizing Small`;

const description = page === 1
  ? 'Closet and bedroom storage I measured and rebuilt in my own apartment: clothing, shoes, seasonal bins, and before-and-after photos.'
  : `More closet and wardrobe projects from my apartment, page ${page}.`;

const prevUrl = page > 2 ? `/closet/${page - 1}/` : '/closet/';
const nextUrl = page < data.totalPages ? `/closet/${page + 1}/` : undefined;
---

<BaseLayout 
  title={title}
  description={description}
  prevUrl={prevUrl}
  nextUrl={nextUrl}
  robots={page > 1 ? 'noindex, follow' : undefined}
>
  <section class="category-section">
    <div class="category-header">
      <h1 class="category-title">👕 Closet & Bedroom Organization</h1>
      <p class="category-description">
        Wardrobe storage, shoe racks & under-bed organization tips
      </p>
      <p class="category-count">
        {data.posts.length} articles in this category
        {data.totalPages > 1 && ` • Page ${page} of ${data.totalPages}`}
      </p>
    </div>

    <!-- Subcategory Navigation -->
    <SubcategoryNav category="Closet" />

    {data.posts.length > 0 ? (
      <>
        <div class="articles-grid">
          {data.posts.map((post, index) => (
            <div class="article-wrapper" style={`animation-delay: ${index * 50}ms`}>
              <ArticleCard
                title={post.data.title}
                description={post.data.description}
                url={post.url}
                tags={post.data.tags}
                category={post.data.category}
                date={post.data.pubDate}
                readingTime={post.data.readingTime || 5}
              />
            </div>
          ))}
        </div>

        {data.totalPages > 1 && (
          <Pagination
            currentPage={page}
            totalPages={data.totalPages}
            baseUrl="/closet/"
          />
        )}
      </>
    ) : (
      <div class="empty-state">
        <p>Nothing filed under Closet yet.</p>
      </div>
    )}
  </section>

</BaseLayout>

<style>
  .category-section {
    animation: fadeInUp 0.6s ease-out;
  }

  .category-header {
    text-align: center;
    margin-bottom: 3rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .category-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .category-description {
    font-size: 1.1rem;
    color: var(--color-text-light);
    max-width: 600px;
    margin: 0 auto 1rem;
    line-height: 1.8;
  }

  .category-count {
    font-size: 0.95rem;
    color: var(--color-secondary);
    margin: 0;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .article-wrapper {
    animation: fadeInUp 0.6s ease-out forwards;
    opacity: 0;
  }

  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
    background: var(--color-bg-light);
    border-radius: var(--radius-lg);
    border: 1px dashed var(--color-border);
  }

  .empty-state p {
    margin: 0;
    color: var(--color-text-light);
    font-size: 1.05rem;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .category-header {
      padding: 1.5rem 0;
      margin-bottom: 2rem;
    }

    .category-title {
      font-size: 1.5rem;
    }

    .articles-grid {
      gap: 1.25rem;
    }
  }
</style>
