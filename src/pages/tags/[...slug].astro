---
import { getAllTags, getTagPaginated } from '../../utils/content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const allTags = await getAllTags();
  const paths: any[] = [];
  
  for (const [tag] of allTags) {
    // 第 1 页
    const firstPage = await getTagPaginated(tag, 1);
    paths.push({
      params: { slug: tag },
      props: { tag, page: 1, totalPages: firstPage.totalPages },
    });
    
    // 后续分页
    for (let p = 2; p <= firstPage.totalPages; p++) {
      paths.push({
        params: { slug: `${tag}/${p}` },
        props: { tag, page: p, totalPages: firstPage.totalPages },
      });
    }
  }
  
  return paths;
}

interface Props {
  tag: string;
  page: number;
  totalPages: number;
}

const { tag, page, totalPages } = Astro.props;
const data = await getTagPaginated(tag, page);

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Tags', path: '/tags/' },
  { name: tag, path: '#' },
];
---

<BaseLayout 
  title={`Articles tagged with "${tag}" - Home Organization Blog`}
  description={`Browse ${data.total} articles about ${tag}. Real home organization solutions and tips.`}
>
  <!-- Breadcrumbs -->
  <nav style="margin-bottom: 2rem; font-size: 0.95rem;">
    <a href="/" style="color: var(--color-primary);">Home</a>
    <span style="color: var(--color-text-light);">  /  </span>
    <a href="/tags/" style="color: var(--color-primary);">Tags</a>
    <span style="color: var(--color-text-light);">  /  </span>
    <span style="color: var(--color-text);">{tag}</span>
  </nav>

  <!-- Header -->
  <section style="margin-bottom: 3rem;">
    <h1 style="margin-bottom: 0.5rem;">🏷️ {tag}</h1>
    <p style="color: var(--color-text-light); font-size: 1.05rem; margin: 0;">
      {data.total} article{data.total !== 1 ? 's' : ''} about {tag}
    </p>
  </section>

  <!-- Articles -->
  {data.posts.length > 0 ? (
    <section>
      <div style="display: grid; gap: 1.5rem; margin-bottom: 3rem;">
        {data.posts.map(post => (
          <article style="
            padding: 1.5rem;
            background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
            border: 1px solid var(--color-border);
            border-radius: 0.75rem;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
          "
          onmouseenter="this.style.borderColor='var(--color-primary)'; this.style.boxShadow='0 10px 15px -3px rgba(0, 0, 0, 0.1)';"
          onmouseleave="this.style.borderColor='var(--color-border)'; this.style.boxShadow='0 1px 2px 0 rgba(0, 0, 0, 0.05)';">
            <a href={`/blog/${post.slug}/`} style="text-decoration: none; color: inherit;">
              <h2 style="margin: 0 0 0.5rem 0; font-size: 1.25rem; color: var(--color-text);">
                {post.data.title}
              </h2>
            </a>
            <p style="color: var(--color-text-light); margin: 0.5rem 0 1rem 0; line-height: 1.6;">
              {post.data.description}
            </p>
            <div style="display: flex; gap: 1.5rem; flex-wrap: wrap; font-size: 0.9rem; color: var(--color-text-light);">
              <span>📅 {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
              <span>📁 {post.data.category}</span>
              <span>🏷️ {post.data.subcategory}</span>
              <a href={`/blog/${post.slug}/`} style="color: var(--color-primary); font-weight: 500;">
                Read More →
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- Pagination -->
      {totalPages > 1 && (
        <nav style="
          display: flex;
          justify-content: center;
          gap: 0.5rem;
          margin-top: 3rem;
          flex-wrap: wrap;
        ">
          {page > 1 && (
            <a href={page === 2 ? `/tags/${tag}/` : `/tags/${tag}/${page - 1}/`}
               style="
                 padding: 0.75rem 1rem;
                 background: var(--color-primary);
                 color: white;
                 border-radius: 0.5rem;
                 text-decoration: none;
                 transition: all 0.3s ease;
               "
               onmouseenter="this.style.backgroundColor='var(--color-primary-dark)';"
               onmouseleave="this.style.backgroundColor='var(--color-primary)';">
              ← Previous
            </a>
          )}
          
          {Array.from({ length: totalPages }, (_, i) => i + 1).map(p => (
            <a href={p === 1 ? `/tags/${tag}/` : `/tags/${tag}/${p}/`}
               style={`
                 padding: 0.75rem 1rem;
                 background: ${p === page ? 'var(--color-primary)' : 'var(--color-bg-light)'};
                 color: ${p === page ? 'white' : 'var(--color-text)'};
                 border: 1px solid ${p === page ? 'var(--color-primary)' : 'var(--color-border)'};
                 border-radius: 0.5rem;
                 text-decoration: none;
                 transition: all 0.3s ease;
                 font-weight: ${p === page ? '600' : 'normal'};
               `}
               onmouseenter={p !== page ? "this.style.backgroundColor='var(--color-bg)'; this.style.borderColor='var(--color-primary)';" : ''}
               onmouseleave={p !== page ? "this.style.backgroundColor='var(--color-bg-light)'; this.style.borderColor='var(--color-border)';" : ''}>
              {p}
            </a>
          ))}
          
          {page < totalPages && (
            <a href={`/tags/${tag}/${page + 1}/`}
               style="
                 padding: 0.75rem 1rem;
                 background: var(--color-primary);
                 color: white;
                 border-radius: 0.5rem;
                 text-decoration: none;
                 transition: all 0.3s ease;
               "
               onmouseenter="this.style.backgroundColor='var(--color-primary-dark)';"
               onmouseleave="this.style.backgroundColor='var(--color-primary)';">
              Next →
            </a>
          )}
        </nav>
      )}
    </section>
  ) : (
    <div style="
      padding: 3rem 2rem;
      text-align: center;
      background: var(--color-bg-light);
      border-radius: 0.75rem;
      border: 1px dashed var(--color-border);
    ">
      <p style="margin: 0; color: var(--color-text-light); font-size: 1.05rem;">
        No articles found with this tag yet.
      </p>
    </div>
  )}
</BaseLayout>
