---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Pagination from '../../components/Pagination.astro';
import { getTagPaginatedEnhanced, getAllTags } from '../../utils/content';

export async function getStaticPaths() {
  const allTags = await getAllTags();
  const paths = [];

  for (const [tag] of allTags) {
    const data = await getTagPaginatedEnhanced(tag, 1);
    for (let page = 1; page <= data.totalPages; page++) {
      paths.push({
        params: {
          slug: page === 1 
            ? tag.toLowerCase().replace(/\s+/g, '-')
            : `${tag.toLowerCase().replace(/\s+/g, '-')}/${page}`,
        },
        props: { tag, page },
      });
    }
  }

  return paths;
}

interface Props {
  tag: string;
  page: number;
}

const { tag, page = 1 } = Astro.props as Props;
const data = await getTagPaginatedEnhanced(tag, page);

const tagSlug = tag.toLowerCase().replace(/\s+/g, '-');
const canonicalUrl = page === 1
  ? `${Astro.url.origin}/tags/${tagSlug}/`
  : `${Astro.url.origin}/tags/${tagSlug}/${page}/`;
---

<BaseLayout 
  title={`Articles tagged with "${tag}" - Page ${page}`}
  description={`Showing ${data.posts.length} articles tagged with ${tag}. Page ${page} of ${data.totalPages}.`}
  robots="noindex, follow"
>
  <section class="tag-section">
    <div class="tag-header">
      <h1 class="tag-title">
        🏷️ #{tag}
      </h1>
      <p class="tag-description">
        {data.total} articles found
        {data.totalPages > 1 && ` • Page ${page} of ${data.totalPages}`}
      </p>
    </div>

    {data.posts.length > 0 ? (
      <>
        <div class="articles-grid">
          {data.posts.map((post, index) => (
            <div class="article-wrapper" style={`animation-delay: ${index * 50}ms`}>
              <ArticleCard
                title={post.data.title}
                description={post.data.description}
                url={post.url}
                tags={post.data.tags}
                category={post.data.category}
                date={post.data.pubDate}
                readingTime={post.data.readingTime || 5}
              />
            </div>
          ))}
        </div>

        {data.totalPages > 1 && (
          <Pagination
            currentPage={page}
            totalPages={data.totalPages}
            baseUrl={`/tags/${tagSlug}/`}
          />
        )}
      </>
    ) : (
      <div class="empty-state">
        <p>No articles found with this tag.</p>
      </div>
    )}
  </section>

  <link rel="canonical" href={canonicalUrl} />
  {page > 1 && (
    <link rel="prev" href={page > 2 ? `/tags/${tagSlug}/${page - 1}/` : `/tags/${tagSlug}/`} />
  )}
  {page < data.totalPages && (
    <link rel="next" href={`/tags/${tagSlug}/${page + 1}/`} />
  )}
</BaseLayout>

<style>
  .tag-section {
    animation: fadeInUp 0.6s ease-out;
  }

  .tag-header {
    text-align: center;
    margin-bottom: 3rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .tag-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin-bottom: 1rem;
    color: var(--color-primary);
  }

  .tag-description {
    font-size: 1.05rem;
    color: var(--color-text-light);
    margin: 0;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .article-wrapper {
    animation: fadeInUp 0.6s ease-out forwards;
    opacity: 0;
  }

  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
    background: var(--color-bg-light);
    border-radius: var(--radius-lg);
    border: 1px dashed var(--color-border);
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .tag-header {
      padding: 1.5rem 0;
      margin-bottom: 2rem;
    }

    .tag-title {
      font-size: 1.5rem;
    }
  }
</style>
