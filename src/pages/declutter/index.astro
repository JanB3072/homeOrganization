---
// Declutter & Habits category page

import BaseLayout from '../../layouts/BaseLayout.astro';

const subcategories = [
  { name: 'Decluttering Methods', slug: 'declutter', description: 'Method comparison, room-by-room approach, and donation resources' },
  { name: 'Maintenance Routines', slug: 'routines', description: 'Weekly resets, seasonal tidying, and monthly reviews' },
  { name: 'Moving & Packing', slug: 'moving', description: 'Packing systems, box labeling, and moving day tips' }
];
---

<BaseLayout title="Declutter & Habits - Organization Maintenance" description="Decluttering methods, maintenance routines, and moving tips. Learn how to keep your space organized long-term.">
  <h1>Declutter & Habits</h1>
  <p>Organization isn't a one-time project—it's a practice. Here's how I maintain my space through daily habits, seasonal resets, and smart systems.</p>

  <section class="subcategories">
    <h2>Categories</h2>
    <div class="subcategory-grid">
      {subcategories.map(sub => (
        <div class="subcategory-card">
          <h3><a href={`/declutter/${sub.slug}/`}>{sub.name}</a></h3>
          <p>{sub.description}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="articles">
    <h2>Latest Articles</h2>
    <p>Coming soon...</p>
  </section>

  <style>
    .subcategories {
      margin: 2rem 0;
    }

    .subcategory-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1.5rem;
      margin: 1.5rem 0;
    }

    .subcategory-card {
      border: 1px solid #eee;
      padding: 1.5rem;
      border-radius: 8px;
    }

    .subcategory-card h3 {
      margin-top: 0;
    }

    .subcategory-card a {
      text-decoration: none;
    }
  </style>
</BaseLayout>
