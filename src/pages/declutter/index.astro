---
// Declutter category page

import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Pagination from '../../components/Pagination.astro';
import { getPostsByCategory } from '../../utils/content';

const declutterPosts = await getPostsByCategory('Declutter');
const perPage = 12;
const totalPages = Math.ceil(declutterPosts.length / perPage);
const firstPagePosts = declutterPosts.slice(0, perPage);
---

<BaseLayout 
  title="Decluttering Methods & Tips - Organization Routines" 
  description="Decluttering strategies: minimalism methods, moving tips, and maintenance routines to keep your home organized long-term."
>
  <!-- Hero Section -->
  <section style="margin-bottom: 3rem;">
    <div style="background: linear-gradient(135deg, #fef08a 0%, #fde047 100%); padding: 3rem 2rem; border-radius: 1rem; text-align: center;">
      <h1 style="color: #854d0e; margin-bottom: 1rem;">✨ Decluttering</h1>
      <p style="color: #b45309; font-size: 1.1rem; max-width: 600px; margin: 0 auto; line-height: 1.8;">
        Getting organized starts with decluttering. Here are the methods that actually work and how I maintain my organized spaces long-term.
      </p>
    </div>
  </section>

  <!-- Articles -->
  <section>
    <h2 style="margin-bottom: 2rem;">📝 Latest Articles</h2>
    {firstPagePosts.length > 0 ? (
      <>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem;">
          {firstPagePosts.map(post => (
            <ArticleCard
              title={post.data.title}
              description={post.data.description}
              url={post.url}
              tags={post.data.tags}
              category={post.data.category}
              date={post.data.pubDate}
              readingTime={post.data.readingTime}
            />
          ))}
        </div>

        {totalPages > 1 && (
          <Pagination currentPage={1} totalPages={totalPages} baseUrl="/declutter/" />
        )}
      </>
    ) : (
      <div style="
        padding: 3rem 2rem;
        text-align: center;
        background: var(--color-bg-light);
        border-radius: 1rem;
        border: 2px dashed var(--color-border);
      ">
        <p style="margin: 0; color: var(--color-text-light); font-size: 1.05rem;">
          No Declutter articles yet. Check back soon!
        </p>
      </div>
    )}
  </section>
</BaseLayout>
