---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Pagination from '../../components/Pagination.astro';
import SubcategoryNav from '../../components/SubcategoryNav.astro';
import { getCategoryPaginated } from '../../utils/content';

const page = parseInt(Astro.params.page || '1', 10);
const data = await getCategoryPaginated('Declutter', page);

if (page < 1 || page > data.totalPages) {
  return Astro.redirect('/declutter/');
}

export async function getStaticPaths() {
  const d = await getCategoryPaginated('Declutter', 1);
  return Array.from({ length: Math.max(0, d.totalPages - 1) }, (_, i) => ({
    params: { page: String(i + 2) },
  }));
}

const title = page === 1 
  ? 'Decluttering Methods & Moving Tips | Organizing Small'
  : `Decluttering - Page ${page} | Organizing Small`;

const prevUrl = page > 2 ? `/declutter/${page - 1}/` : '/declutter/';
const nextUrl = page < data.totalPages ? `/declutter/${page + 1}/` : undefined;
---

<BaseLayout title={title} description="Decluttering and moving notes from my own last move, including the boxes I paid to carry and never opened." prevUrl={prevUrl} nextUrl={nextUrl}>
  <section class="category-section">
    <div class="category-header">
      <h1 class="category-title">✨ Decluttering & Moving</h1>
      <p class="category-description">Methods, routines & moving organization tips</p>
      <p class="category-count">{data.posts.length} articles{data.totalPages > 1 && ` • Page ${page} of ${data.totalPages}`}</p>
    </div>

    <!-- Subcategory Navigation -->
    <SubcategoryNav category="Declutter" />

    {data.posts.length > 0 ? (
      <>
        <div class="articles-grid">
          {data.posts.map((post, i) => (
            <div style={`animation-delay: ${i * 50}ms`}>
              <ArticleCard {...post.data} url={post.url} readingTime={post.data.readingTime || 5} />
            </div>
          ))}
        </div>
        {data.totalPages > 1 && <Pagination currentPage={page} totalPages={data.totalPages} baseUrl="/declutter/" />}
      </>
    ) : (
      <p style="text-align: center; color: var(--color-text-light);">Nothing filed here yet.</p>
    )}
  </section>
</BaseLayout>

<style>
  .category-section { animation: fadeInUp 0.6s ease-out; }
  .category-header { text-align: center; margin-bottom: 3rem; padding: 2rem 0; border-bottom: 1px solid var(--color-border); }
  .category-title { font-size: clamp(1.75rem, 4vw, 2.5rem); margin-bottom: 1rem; }
  .category-description { font-size: 1.1rem; color: var(--color-text-light); margin: 0 auto 1rem; max-width: 600px; }
  .category-count { font-size: 0.95rem; color: var(--color-secondary); }
  .articles-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem; margin-bottom: 3rem; }
  @keyframes fadeInUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; } }
</style>
