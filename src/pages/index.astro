---
// Modern and beautiful homepage

import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryCard from '../components/CategoryCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import AuthorBio from '../components/AuthorBio.astro';
import CTASection from '../components/CTASection.astro';
import BackToTop from '../components/BackToTop.astro';
import { getAllPosts } from '../utils/content';

const allPosts = await getAllPosts();
const recentPosts = allPosts.slice(0, 6);

const categories = [
  {
    name: 'Kitchen',
    icon: '🍳',
    slug: '/kitchen/',
    description: 'Pantry, fridge & cabinet organization',
    articleCount: allPosts.filter(p => p.data.category === 'Kitchen').length,
  },
  {
    name: 'Closet & Bedroom',
    icon: '👕',
    slug: '/closet/',
    description: 'Wardrobe storage & under-bed solutions',
    articleCount: allPosts.filter(p => p.data.category === 'Closet').length,
  },
  {
    name: 'Bathroom',
    icon: '🚿',
    slug: '/bathroom/',
    description: 'Small bathroom hacks & storage',
    articleCount: allPosts.filter(p => p.data.category === 'Bathroom').length,
  },
  {
    name: 'Small Space',
    icon: '🏠',
    slug: '/small-space/',
    description: 'Apartment living & rental solutions',
    articleCount: allPosts.filter(p => p.data.category === 'Small Space').length,
  },
  {
    name: 'Declutter',
    icon: '✨',
    slug: '/declutter/',
    description: 'Methods, routines & moving tips',
    articleCount: allPosts.filter(p => p.data.category === 'Declutter').length,
  },
  {
    name: 'Whole-Home Guides',
    icon: '🧭',
    slug: '/guides/',
    description: 'Complete systems, measurements & decision trees',
    articleCount: allPosts.filter(p => p.data.category === 'Guides').length,
  },
];
---

<BaseLayout 
  title="Organizing Small - Home Organization Ideas & Real Solutions"
  description="A personal home organization blog with real solutions, before-and-after transformations, and practical storage ideas for small spaces."
>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="hero-content">
      <h1 class="hero-title">
        Real Home Organization Stories
      </h1>
      <p class="hero-subtitle">
        I'm sharing my real experience organizing a small apartment. Every article is tested, measured, and photographed in my own home—no stock photos, just what actually works.
      </p>
      <div class="hero-cta">
        <a href="#categories" class="hero-button">
          Explore by Room →
        </a>
      </div>
    </div>
    <div class="hero-decoration"></div>
  </section>

  <!-- Categories Grid -->
  <section id="categories" class="categories-section">
    <h2 class="section-title">Browse by Room</h2>
    
    <div class="categories-grid">
      {categories.map((cat) => (
        <CategoryCard
          name={cat.name}
          icon={cat.icon}
          slug={cat.slug}
          description={cat.description}
          articleCount={cat.articleCount}
        />
      ))}
    </div>
  </section>

  <!-- Latest Posts Section -->
  <section class="latest-section">
    <h2 class="section-title">Latest Articles</h2>
    
    {recentPosts.length > 0 ? (
      <div class="articles-grid">
        {recentPosts.map((post, index) => (
          <div class="article-wrapper" style={`animation-delay: ${index * 50}ms`}>
            <ArticleCard
              title={post.data.title}
              description={post.data.description}
              url={post.url}
              tags={post.data.tags}
              category={post.data.category}
              date={post.data.pubDate}
              readingTime={post.data.readingTime || 5}
            />
          </div>
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <p>✍️ New articles coming soon. Check back regularly for updates!</p>
      </div>
    )}
  </section>

  <!-- CTA Section -->
  <AuthorBio />

  <section style="margin: 3rem 0;">
    <h2 style="text-align: center; margin-bottom: 1.5rem;">From my apartment</h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 0.75rem;">
      <img src="/images/clara-apartment-1.jpg" alt="Clara's small-apartment organization, shot on iPhone" loading="lazy" style="width: 100%; border-radius: 0.75rem; aspect-ratio: 1 / 1; object-fit: cover;" />
      <img src="/images/clara-apartment-2.jpg" alt="Clara's small-apartment organization, shot on iPhone" loading="lazy" style="width: 100%; border-radius: 0.75rem; aspect-ratio: 1 / 1; object-fit: cover;" />
      <img src="/images/clara-apartment-3.jpg" alt="Clara's small-apartment organization, shot on iPhone" loading="lazy" style="width: 100%; border-radius: 0.75rem; aspect-ratio: 1 / 1; object-fit: cover;" />
      <img src="/images/clara-apartment-4.jpg" alt="Clara's small-apartment organization, shot on iPhone" loading="lazy" style="width: 100%; border-radius: 0.75rem; aspect-ratio: 1 / 1; object-fit: cover;" />
    </div>
  </section>

  <CTASection />

  <!-- Back to Top Button -->
  <BackToTop />
</BaseLayout>

<style>
  /* Hero Section */
  .hero-section {
    position: relative;
    text-align: center;
    margin-bottom: 4rem;
    padding: 3rem 0;
    overflow: hidden;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    animation: fadeInUp 0.8s ease-out;
  }

  .hero-title {
    margin-bottom: 1.5rem;
    background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-size: clamp(2.25rem, 6vw, 3.5rem);
  }

  .hero-subtitle {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: var(--color-text-light);
    max-width: 650px;
    margin: 0 auto 2rem;
    line-height: 1.8;
    letter-spacing: 0.3px;
  }

  .hero-cta {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hero-button {
    display: inline-block;
    padding: 1rem 2.5rem;
    background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
    color: white;
    border-radius: var(--radius-lg);
    font-weight: 700;
    font-size: 1rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: var(--shadow-lg);
    position: relative;
    overflow: hidden;
  }

  .hero-button::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
    transform: translateX(-100%);
    transition: transform 0.3s ease;
  }

  .hero-button:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-xl);
  }

  .hero-button:hover::before {
    transform: translateX(0);
  }

  .hero-decoration {
    position: absolute;
    top: -100px;
    right: -100px;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, var(--color-primary-light) 0%, transparent 70%);
    opacity: 0.1;
    border-radius: 50%;
    pointer-events: none;
  }

  /* Section Styles */
  .categories-section,
  .latest-section {
    margin-bottom: 4rem;
    animation: fadeInUp 0.6s ease-out;
  }

  .section-title {
    text-align: center;
    margin-bottom: 3rem;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    position: relative;
    padding-bottom: 1rem;
  }

  .section-title::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 60px;
    height: 3px;
    background: linear-gradient(90deg, transparent, var(--color-primary), transparent);
    transform: translateX(-50%);
  }

  /* Categories Grid */
  .categories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  /* Articles Grid */
  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .article-wrapper {
    animation: fadeInUp 0.6s ease-out forwards;
    opacity: 0;
  }

  /* Empty State */
  .empty-state {
    padding: 4rem 2rem;
    text-align: center;
    background: var(--color-bg-light);
    border-radius: var(--radius-xl);
    border: 1px dashed var(--color-border);
  }

  .empty-state p {
    margin: 0;
    color: var(--color-text-light);
    font-size: 1.1rem;
  }

  /* Keyframes */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero-section {
      padding: 2rem 0 3rem;
    }

    .hero-title {
      font-size: 2rem;
    }

    .hero-subtitle {
      font-size: 1rem;
      margin-bottom: 1.5rem;
    }

    .categories-grid {
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
    }

    .articles-grid {
      gap: 1.25rem;
    }
  }

  @media (max-width: 480px) {
    .hero-section {
      padding: 1.5rem 0 2.5rem;
    }

    .hero-title {
      font-size: 1.6rem;
      margin-bottom: 1rem;
    }

    .hero-subtitle {
      font-size: 0.95rem;
      margin-bottom: 1.5rem;
    }

    .categories-grid {
      grid-template-columns: 1fr;
    }

    .section-title {
      margin-bottom: 2rem;
      font-size: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-content,
    .categories-section,
    .latest-section,
    .hero-button,
    .article-wrapper {
      animation: none;
    }

    .hero-button:hover {
      transform: none;
    }
  }
</style>
