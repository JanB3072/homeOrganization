---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllPosts } from '../utils/content';

const posts = await getAllPosts();
const index = posts.map(p => ({
  title: p.data.title,
  description: p.data.description,
  url: p.url,
  category: p.data.category,
  tags: p.data.tags,
  readingTime: p.data.readingTime,
}));
---

<BaseLayout
  title="Search Articles"
  description="Search every article on Organizing Small by room, item, or measurement."
>
  <section class="search-section">
    <div class="search-header">
      <h1 class="search-title">🔍 Search Articles</h1>

      <form method="get" class="search-form">
        <input
          type="text"
          name="q"
          id="search-input"
          placeholder="Try a room, an item, or a measurement..."
          class="search-input"
          autocomplete="off"
        />
        <button type="submit" class="search-button">Search</button>
      </form>
    </div>

    <div id="search-results" aria-live="polite">
      <p class="search-hint">Every article I have written is here. Search by room, item, or measurement, or start with one of these:</p>
      <div class="search-tags">
        {['pantry', 'closet', 'bathroom', 'moving', 'under-bed'].map(term => (
          <a href={`/search/?q=${encodeURIComponent(term)}`} class="search-tag">{term}</a>
        ))}
      </div>
    </div>

    <noscript>
      <p>Search needs JavaScript. The <a href="/archive/">archive</a> lists every article in date order.</p>
    </noscript>
  </section>

  <script define:vars={{ posts: index }}>
  const params = new URLSearchParams(window.location.search);
  const q = (params.get('q') || '').trim();
  const input = document.getElementById('search-input');
  const container = document.getElementById('search-results');
  if (input) input.value = q;

  const escapeHtml = (value) => String(value).replace(/[&<>"']/g, (c) => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
  }[c]));

  if (q.length > 2 && container) {
    const needle = q.toLowerCase();
    const matches = posts.filter(p =>
      p.title.toLowerCase().includes(needle) ||
      p.description.toLowerCase().includes(needle) ||
      p.tags.some(t => t.toLowerCase().includes(needle))
    );

    if (!matches.length) {
      container.innerHTML = `<p class="search-info">Nothing matches "${escapeHtml(q)}" yet. Try a room name like pantry or closet.</p>`;
    } else {
      const cards = matches.map(p => `
        <a class="result-card" href="${escapeHtml(p.url)}">
          <span class="result-meta">${escapeHtml(p.category)} · ${p.readingTime} min read</span>
          <span class="result-title">${escapeHtml(p.title)}</span>
          <span class="result-description">${escapeHtml(p.description)}</span>
        </a>
      `).join('');
      container.innerHTML = `<p class="search-info">${matches.length} ${matches.length === 1 ? 'article' : 'articles'} for "${escapeHtml(q)}".</p><div class="results-grid">${cards}</div>`;
    }
  }
  </script>
</BaseLayout>

<style is:global>
  #search-results .search-hint { color: var(--color-text-light); margin-bottom: 1rem; }
  #search-results .search-info { margin-bottom: 1rem; color: var(--color-text-light); }
  #search-results .search-tags { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  #search-results .results-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.25rem; margin-top: 1.5rem; }
  #search-results .result-card { display: flex; flex-direction: column; gap: 0.5rem; padding: 1.25rem; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-bg); color: var(--color-text); }
  #search-results .result-card:hover { border-color: var(--color-primary); }
  #search-results .result-meta { font-size: 0.8rem; color: var(--color-secondary); }
  #search-results .result-title { font-size: 1.1rem; font-weight: 600; }
  #search-results .result-description { font-size: 0.92rem; color: var(--color-text-light); }
</style>

<style>
  .search-section {
    animation: fadeInUp 0.6s ease-out;
  }

  .search-header {
    text-align: center;
    margin-bottom: 3rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .search-title {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 2rem;
    color: var(--color-text);
  }

  .search-form {
    display: flex;
    gap: 0.75rem;
    max-width: 600px;
    margin: 0 auto 1.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .search-input {
    flex: 1;
    min-width: 250px;
    padding: 1rem;
    border: 2px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: 1rem;
    font-family: var(--font-primary);
    transition: all 0.3s ease;
  }

  .search-input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
  }

  .search-button {
    padding: 1rem 2rem;
    background: var(--color-primary);
    color: white;
    border: none;
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.3s ease;
    font-family: var(--font-primary);
  }

  .search-button:hover {
    background: var(--color-primary-dark);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .search-button:active {
    transform: translateY(0);
  }

  .search-info {
    font-size: 1.05rem;
    color: var(--color-text-light);
    margin: 0;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .article-wrapper {
    animation: fadeInUp 0.6s ease-out forwards;
    opacity: 0;
  }

  .no-results,
  .empty-search {
    text-align: center;
    padding: 3rem 2rem;
    background: var(--color-bg-light);
    border-radius: var(--radius-lg);
    border: 1px dashed var(--color-border);
  }

  .no-results p,
  .empty-search p {
    margin-bottom: 1.5rem;
    color: var(--color-text-light);
  }

  .no-results ul {
    list-style: none;
    padding: 0;
    margin: 0;
    text-align: left;
    max-width: 400px;
    margin-left: auto;
    margin-right: auto;
  }

  .no-results li {
    margin-bottom: 0.75rem;
    color: var(--color-text-light);
  }

  .search-tags {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .search-tag {
    padding: 0.5rem 1rem;
    background: var(--color-primary);
    color: white;
    border-radius: 2rem;
    text-decoration: none;
    font-size: 0.9rem;
    transition: all 0.3s ease;
  }

  .search-tag:hover {
    background: var(--color-primary-dark);
    transform: translateY(-2px);
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .search-header {
      padding: 1.5rem 0;
    }

    .search-form {
      flex-direction: column;
    }

    .search-input,
    .search-button {
      width: 100%;
    }

    .no-results ul,
    .search-tags {
      max-width: none;
    }
  }
</style>
