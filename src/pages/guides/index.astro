---
// Guides category page: whole-home systems and reference guides

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPostsByCategory } from '../../utils/content';

const guidePosts = await getPostsByCategory('Guides');
---

<BaseLayout
  title="Home Organization Guides - Whole-Home Systems"
  description="Complete home organization systems: measure first, diagnose why each room fails, follow the decision trees, and build a plan that holds for years."
>
  <section style="margin-bottom: 3rem;">
    <div style="background: linear-gradient(135deg, #e0e7ff 0%, #c7d2fe 100%); padding: 3rem 2rem; border-radius: 1rem; text-align: center;">
      <h1 style="color: #3730a3; margin-bottom: 1rem;">Whole-Home Guides</h1>
      <p style="color: #4338ca; font-size: 1.1rem; max-width: 640px; margin: 0 auto; line-height: 1.8;">
        Room-by-room fixes are chapters of one system. These guides cover the measurements, decision trees, budgets, and maintenance rhythms that connect them.
      </p>
    </div>
  </section>

  <section>
    <h2 style="margin-bottom: 2rem;">Guides</h2>
    {guidePosts.length > 0 ? (
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem;">
        {guidePosts.map(post => (
          <article style="
            padding: 1.5rem;
            background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
            border: 1px solid var(--color-border);
            border-radius: 0.75rem;
            transition: all 0.3s ease;
          "
          onmouseenter="this.style.borderColor='var(--color-primary)'; this.style.boxShadow='0 10px 15px -3px rgba(0, 0, 0, 0.1)';"
          onmouseleave="this.style.borderColor='var(--color-border)'; this.style.boxShadow='0 1px 2px 0 rgba(0, 0, 0, 0.05)';">
            <a href={`/blog/${post.slug}/`} style="text-decoration: none; color: inherit;">
              <h3 style="margin: 0 0 0.5rem 0; color: var(--color-text);">{post.data.title}</h3>
            </a>
            <p style="color: var(--color-text-light); margin: 0.5rem 0 1rem 0; line-height: 1.6;">
              {post.data.description}
            </p>
            <div style="display: flex; gap: 1.5rem; font-size: 0.9rem; color: var(--color-text-light);">
              <span>{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
              <a href={`/blog/${post.slug}/`} style="color: var(--color-primary); text-decoration: none; margin-left: auto;">
                Read More
              </a>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div style="
        padding: 3rem 2rem;
        text-align: center;
        background: var(--color-bg-light);
        border-radius: 1rem;
        border: 2px dashed var(--color-border);
      ">
        <p style="margin: 0; color: var(--color-text-light); font-size: 1.05rem;">
          No guides yet. Check back soon!
        </p>
      </div>
    )}
  </section>
</BaseLayout>
