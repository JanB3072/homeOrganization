---
import { getCollection } from 'astro:content';
import { getRelatedPosts } from '../../utils/content';
import { categoryUrl, postUrl } from '../../utils/slugs';
import PostLayout from '../../layouts/PostLayout.astro';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', 
    ({ data }) => !data.draft
  );
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await post.render();
const relatedPosts = await getRelatedPosts(post.slug, 3);

const breadcrumbs = [
  { name: post.data.category, path: categoryUrl(post.data.category) },
  { name: post.data.title, path: postUrl(post.slug) },
];
---

<PostLayout
  title={post.data.title}
  description={post.data.description}
  author="Clara"
  image={post.data.image}
  imageAlt={post.data.imageAlt}
  body={post.body}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  category={post.data.category}
  subcategory={post.data.subcategory}
  tags={post.data.tags}
  takeaways={post.data.takeaways}
  faq={post.data.faq}
  howTo={post.data.howTo}
  breadcrumbs={breadcrumbs}
  relatedPosts={relatedPosts}
  currentSlug={post.slug}
>
  <Content />
</PostLayout>
