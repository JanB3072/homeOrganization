---
// Small Space category page

import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Pagination from '../../components/Pagination.astro';
import { getPostsByCategory } from '../../utils/content';

const smallSpacePosts = await getPostsByCategory('Small Space');
const perPage = 12;
const totalPages = Math.ceil(smallSpacePosts.length / perPage);
const firstPagePosts = smallSpacePosts.slice(0, perPage);
---

<BaseLayout 
  title="Small Space Organization - Apartment Living Tips" 
  description="Small space and apartment organization ideas: how to maximize limited storage, multifunctional furniture, and rental-friendly solutions."
>
  <!-- Hero Section -->
  <section style="margin-bottom: 3rem;">
    <div style="background: linear-gradient(135deg, #dcfce7 0%, #bbf7d0 100%); padding: 3rem 2rem; border-radius: 1rem; text-align: center;">
      <h1 style="color: #166534; margin-bottom: 1rem;">🏠 Small Space Living</h1>
      <p style="color: #22c55e; font-size: 1.1rem; max-width: 600px; margin: 0 auto; line-height: 1.8;">
        Small spaces demand smart storage. Here's how I organize and maximize every inch of my apartment without losing my mind.
      </p>
    </div>
  </section>

  <!-- Articles -->
  <section>
    <h2 style="margin-bottom: 2rem;">📝 Latest Articles</h2>
    {firstPagePosts.length > 0 ? (
      <>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem;">
          {firstPagePosts.map(post => (
            <ArticleCard
              title={post.data.title}
              description={post.data.description}
              url={post.url}
              tags={post.data.tags}
              category={post.data.category}
              date={post.data.pubDate}
              readingTime={post.data.readingTime}
            />
          ))}
        </div>

        {totalPages > 1 && (
          <Pagination currentPage={1} totalPages={totalPages} baseUrl="/small-space/" />
        )}
      </>
    ) : (
      <div style="
        padding: 3rem 2rem;
        text-align: center;
        background: var(--color-bg-light);
        border-radius: 1rem;
        border: 2px dashed var(--color-border);
      ">
        <p style="margin: 0; color: var(--color-text-light); font-size: 1.05rem;">
          No Small Space articles yet. Check back soon!
        </p>
      </div>
    )}
  </section>
</BaseLayout>
