---
// Small Space category page

import BaseLayout from '../../layouts/BaseLayout.astro';

const subcategories = [
  { name: 'Apartment Living', slug: 'apartment', description: 'Vertical space, multi-purpose furniture, and flow' },
  { name: 'Rental-Friendly', slug: 'rental', description: 'No-drill solutions, removable storage, and damage-free moves' }
];
---

<BaseLayout title="Small Space Organization - Apartment Ideas" description="Small apartment organization: apartment layout, rental-friendly solutions, and space-maximizing techniques for small living spaces.">
  <h1>Small Space Organization</h1>
  <p>Living in a small space requires different strategies. Here's my apartment layout plus room-by-room organization plans you can adapt.</p>

  <section class="subcategories">
    <h2>Categories</h2>
    <div class="subcategory-grid">
      {subcategories.map(sub => (
        <div class="subcategory-card">
          <h3><a href={`/small-space/${sub.slug}/`}>{sub.name}</a></h3>
          <p>{sub.description}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="articles">
    <h2>Latest Articles</h2>
    <p>Coming soon...</p>
  </section>

  <style>
    .subcategories {
      margin: 2rem 0;
    }

    .subcategory-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1.5rem;
      margin: 1.5rem 0;
    }

    .subcategory-card {
      border: 1px solid #eee;
      padding: 1.5rem;
      border-radius: 8px;
    }

    .subcategory-card h3 {
      margin-top: 0;
    }

    .subcategory-card a {
      text-decoration: none;
    }
  </style>
</BaseLayout>
