---
import { getSubcategoryPaginated } from '../../utils/content';
import SubcategoryLayout from '../../layouts/SubcategoryLayout.astro';

const data = await getSubcategoryPaginated('Bathroom', 'Vanity', 1);
---

<SubcategoryLayout 
  category="Bathroom"
  subcategory="Vanity"
  posts={data.posts}
  currentPage={1}
  totalPages={data.totalPages}
  pageTitle="Bathroom Vanity Organization"
  pageDescription="Bathroom vanity organization splits three ways: how to organize your vanity drawers, a makeup vanity table with lights and storage, and a DIY vanity makeover. Lighting, marble, and mirrors are separate."
  heading="Bathroom Vanity Organization"
/>
