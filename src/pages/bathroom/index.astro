---
// Bathroom category page

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPostsByCategory } from '../../utils/content';

const bathroomPosts = await getPostsByCategory('Bathroom');
---

<BaseLayout 
  title="Bathroom Organization - Storage Solutions" 
  description="Bathroom storage ideas: under-sink organization, medicine cabinet setup, and small bathroom hacks. Real solutions for limited space."
>
  <!-- Hero Section -->
  <section style="margin-bottom: 3rem;">
    <div style="background: linear-gradient(135deg, #cffafe 0%, #a5f3fc 100%); padding: 3rem 2rem; border-radius: 1rem; text-align: center;">
      <h1 style="color: #0e7490; margin-bottom: 1rem;">🚿 Bathroom Organization</h1>
      <p style="color: #155e75; font-size: 1.1rem; max-width: 600px; margin: 0 auto; line-height: 1.8;">
        Small bathrooms need big organization strategies. Here's how I organized my under-sink storage, medicine cabinet, and shower area.
      </p>
    </div>
  </section>

  <!-- Articles -->
  <section>
    <h2 style="margin-bottom: 2rem;">📝 Latest Articles</h2>
    {bathroomPosts.length > 0 ? (
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem;">
        {bathroomPosts.map(post => (
          <article style="
            padding: 1.5rem;
            background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
            border: 1px solid var(--color-border);
            border-radius: 0.75rem;
            transition: all 0.3s ease;
          "
          onmouseenter="this.style.borderColor='var(--color-primary)'; this.style.boxShadow='0 10px 15px -3px rgba(0, 0, 0, 0.1)';"
          onmouseleave="this.style.borderColor='var(--color-border)'; this.style.boxShadow='0 1px 2px 0 rgba(0, 0, 0, 0.05)';">
            <a href={`/blog/${post.slug}/`} style="text-decoration: none; color: inherit;">
              <h3 style="margin: 0 0 0.5rem 0; color: var(--color-text);">{post.data.title}</h3>
            </a>
            <p style="color: var(--color-text-light); margin: 0.5rem 0 1rem 0; line-height: 1.6;">
              {post.data.description}
            </p>
            <div style="display: flex; gap: 1.5rem; font-size: 0.9rem; color: var(--color-text-light);">
              <span>📅 {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
              <a href={`/blog/${post.slug}/`} style="color: var(--color-primary); text-decoration: none; margin-left: auto;">
                Read More →
              </a>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div style="
        padding: 3rem 2rem;
        text-align: center;
        background: var(--color-bg-light);
        border-radius: 1rem;
        border: 2px dashed var(--color-border);
      ">
        <p style="margin: 0; color: var(--color-text-light); font-size: 1.05rem;">
          No Bathroom articles yet. Check back soon!
        </p>
      </div>
    )}
  </section>
</BaseLayout>
