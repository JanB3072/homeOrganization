---
// Bathroom category page

import BaseLayout from '../../layouts/BaseLayout.astro';

const subcategories = [
  { name: 'Vanity & Sink', slug: 'vanity', description: 'Bathroom cabinet storage and under-sink organization' },
  { name: 'Small Bathroom', slug: 'small-bathroom', description: 'No-cabinet solutions, no-drill storage, and mold prevention' }
];
---

<BaseLayout title="Bathroom Organization - Small Space Solutions" description="Bathroom storage ideas for small spaces: vanity organization, no-drill solutions, and moisture prevention tips.">
  <h1>Bathroom Organization</h1>
  <p>A small bathroom demands smart solutions. Here's what I learned organizing a tiny bathroom with limited space and a shared sink setup.</p>

  <section class="subcategories">
    <h2>Categories</h2>
    <div class="subcategory-grid">
      {subcategories.map(sub => (
        <div class="subcategory-card">
          <h3><a href={`/bathroom/${sub.slug}/`}>{sub.name}</a></h3>
          <p>{sub.description}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="articles">
    <h2>Latest Articles</h2>
    <p>Coming soon...</p>
  </section>

  <style>
    .subcategories {
      margin: 2rem 0;
    }

    .subcategory-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1.5rem;
      margin: 1.5rem 0;
    }

    .subcategory-card {
      border: 1px solid #eee;
      padding: 1.5rem;
      border-radius: 8px;
    }

    .subcategory-card h3 {
      margin-top: 0;
    }

    .subcategory-card a {
      text-decoration: none;
    }
  </style>
</BaseLayout>
