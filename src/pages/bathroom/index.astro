---
// Bathroom category page

import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Pagination from '../../components/Pagination.astro';
import HubIntro from '../../components/HubIntro.astro';
import { getPostsByCategory } from '../../utils/content';

const bathroomPosts = await getPostsByCategory('Bathroom');
const perPage = 12;
const totalPages = Math.ceil(bathroomPosts.length / perPage);
const firstPagePosts = bathroomPosts.slice(0, perPage);
---

<BaseLayout 
  title="Bathroom Organization - Storage Solutions" 
  description="Bathroom storage ideas: under-sink organization, medicine cabinet setup, and small bathroom hacks. Real solutions for limited space."
>
  <!-- Hero Section -->
  <section style="margin-bottom: 3rem;">
    <div style="background: linear-gradient(135deg, #cffafe 0%, #a5f3fc 100%); padding: 3rem 2rem; border-radius: 1rem; text-align: center;">
      <h1 style="color: #0e7490; margin-bottom: 1rem;">🚿 Bathroom Organization</h1>
      <p style="color: #155e75; font-size: 1.1rem; max-width: 600px; margin: 0 auto; line-height: 1.8;">
        Small bathrooms need big organization strategies. Here's how I organized my under-sink storage, medicine cabinet, and shower area.
      </p>
    </div>
  </section>

  <!-- Articles -->
  <section>
  <HubIntro category="Bathroom" />

    <h2 style="margin-bottom: 2rem;">📝 Latest Articles</h2>
    {firstPagePosts.length > 0 ? (
      <>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem;">
          {firstPagePosts.map(post => (
            <ArticleCard
              title={post.data.title}
              description={post.data.description}
              url={post.url}
              tags={post.data.tags}
              category={post.data.category}
              date={post.data.pubDate}
              readingTime={post.data.readingTime}
            />
          ))}
        </div>

        {totalPages > 1 && (
          <Pagination currentPage={1} totalPages={totalPages} baseUrl="/bathroom/" />
        )}
      </>
    ) : (
      <div style="
        padding: 3rem 2rem;
        text-align: center;
        background: var(--color-bg-light);
        border-radius: 1rem;
        border: 2px dashed var(--color-border);
      ">
        <p style="margin: 0; color: var(--color-text-light); font-size: 1.05rem;">
          I haven't written a bathroom article for this page yet.
        </p>
      </div>
    )}
  </section>
</BaseLayout>
