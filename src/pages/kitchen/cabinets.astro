---
import { getSubcategoryPaginated } from '../../utils/content';
import SubcategoryLayout from '../../layouts/SubcategoryLayout.astro';

const data = await getSubcategoryPaginated('Kitchen', 'Cabinets', 1);
---

<SubcategoryLayout 
  category="Kitchen"
  subcategory="Cabinets"
  posts={data.posts}
  currentPage={1}
  totalPages={data.totalPages}
/>
