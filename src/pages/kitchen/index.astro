---
// Kitchen category page - Beautiful and modern

import BaseLayout from '../../layouts/BaseLayout.astro';

const subcategories = [
  { 
    name: 'Pantry Organization', 
    slug: 'pantry', 
    icon: '🥫',
    description: 'Food storage, dry goods, and expiration date management' 
  },
  { 
    name: 'Fridge Storage', 
    slug: 'fridge', 
    icon: '❄️',
    description: 'Fridge zones, food preservation, and freezer organization' 
  },
  { 
    name: 'Cabinets & Counters', 
    slug: 'cabinets', 
    icon: '🍽️',
    description: 'Drawer dividers, cookware storage, and counter space reduction' 
  }
];
---

<BaseLayout 
  title="Kitchen Organization - Storage Ideas and Solutions" 
  description="Kitchen storage solutions: pantry organization, fridge zones, and cabinet organization. Real before-and-after photos from my own kitchen."
>
  <!-- Hero Section -->
  <section style="margin-bottom: 3rem;">
    <div style="background: linear-gradient(135deg, #fef3c7 0%, #fee2e2 100%); padding: 3rem 2rem; border-radius: 1rem; text-align: center;">
      <h1 style="color: #92400e; margin-bottom: 1rem;">🍳 Kitchen Organization</h1>
      <p style="color: #b45309; font-size: 1.1rem; max-width: 600px; margin: 0 auto; line-height: 1.8;">
        The kitchen is where the most chaos happens. Here's my complete breakdown of how I organized my pantry, fridge, and cabinets—with real photos and measurements.
      </p>
    </div>
  </section>

  <!-- Subcategories Grid -->
  <section style="margin-bottom: 4rem;">
    <h2 style="text-align: center; margin-bottom: 2.5rem; font-size: 1.8rem;">Explore by Zone</h2>
    
    <div style="
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 2rem;
    ">
      {subcategories.map((sub) => (
        <a 
          href={`/kitchen/${sub.slug}/`}
          style="
            display: block;
            padding: 2rem;
            background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
            border: 2px solid var(--color-border);
            border-radius: 1rem;
            text-decoration: none;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
          "
          onmouseenter="this.style.borderColor='#f59e0b'; this.style.transform='translateY(-6px)'; this.style.boxShadow='0 20px 25px -5px rgba(0, 0, 0, 0.1)';"
          onmouseleave="this.style.borderColor='var(--color-border)'; this.style.transform='translateY(0)'; this.style.boxShadow='0 1px 2px 0 rgba(0, 0, 0, 0.05)';"
        >
          <div style="font-size: 2.5rem; margin-bottom: 1rem;">{sub.icon}</div>
          <h3 style="color: var(--color-text); margin: 0.5rem 0; font-size: 1.2rem;">{sub.name}</h3>
          <p style="color: var(--color-text-light); margin: 0; font-size: 0.95rem; line-height: 1.5;">
            {sub.description}
          </p>
        </a>
      ))}
    </div>
  </section>

  <!-- Info Section -->
  <section style="
    background: linear-gradient(135deg, #f0f9ff 0%, #f0fdf4 100%);
    padding: 3rem 2rem;
    border-radius: 1rem;
    border-left: 4px solid var(--color-primary);
    margin-bottom: 3rem;
  ">
    <h2 style="color: var(--color-primary); margin-top: 0; font-size: 1.5rem;">💡 Kitchen Organization Tips</h2>
    <ul style="color: var(--color-text-light); line-height: 1.8;">
      <li>Visibility is key - see what you have, use what you buy</li>
      <li>Zone your storage - keep similar items together</li>
      <li>Measure twice - know your shelf depths before buying organizers</li>
      <li>Test before buying - try systems at home first</li>
      <li>Label everything - especially for the freezer</li>
    </ul>
  </section>

  <!-- Articles Coming Soon -->
  <section>
    <h2 style="margin-bottom: 2rem;">📝 Latest Articles</h2>
    <div style="
      padding: 3rem 2rem;
      text-align: center;
      background: var(--color-bg-light);
      border-radius: 1rem;
      border: 2px dashed var(--color-border);
    ">
      <p style="margin: 0; color: var(--color-text-light); font-size: 1.05rem;">
        Kitchen articles coming soon. Subscribe to get notified when they're published!
      </p>
    </div>
  </section>
</BaseLayout>
