---
// Kitchen category page

import BaseLayout from '../../layouts/BaseLayout.astro';

const subcategories = [
  { name: 'Pantry Organization', slug: 'pantry', description: 'Food storage, dry goods, and expiration date management' },
  { name: 'Fridge Storage', slug: 'fridge', description: 'Fridge zones, food preservation, and freezer organization' },
  { name: 'Cabinets & Counters', slug: 'cabinets', description: 'Drawer dividers, cookware storage, and counter space reduction' }
];
---

<BaseLayout title="Kitchen Organization - Storage Ideas and Solutions" description="Kitchen storage solutions: pantry organization, fridge zones, and cabinet organization. Real before-and-after photos from my own kitchen.">
  <h1>Kitchen Organization</h1>
  <p>The kitchen is where the most chaos happens. Here's my complete breakdown of how I organized my pantry, fridge, and cabinets—with real photos and measurements.</p>

  <section class="subcategories">
    <h2>Categories</h2>
    <div class="subcategory-grid">
      {subcategories.map(sub => (
        <div class="subcategory-card">
          <h3><a href={`/kitchen/${sub.slug}/`}>{sub.name}</a></h3>
          <p>{sub.description}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="articles">
    <h2>Latest Kitchen Articles</h2>
    <p>Coming soon...</p>
  </section>

  <style>
    .subcategories {
      margin: 2rem 0;
    }

    .subcategory-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1.5rem;
      margin: 1.5rem 0;
    }

    .subcategory-card {
      border: 1px solid #eee;
      padding: 1.5rem;
      border-radius: 8px;
    }

    .subcategory-card h3 {
      margin-top: 0;
    }

    .subcategory-card a {
      text-decoration: none;
    }
  </style>
</BaseLayout>
