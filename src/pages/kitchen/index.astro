---
// 厨房分类页

import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Pagination from '../../components/Pagination.astro';
import HubIntro from '../../components/HubIntro.astro';
import { getPostsByCategory } from '../../utils/content';

const kitchenPosts = await getPostsByCategory('Kitchen');
const perPage = 12;
const totalPages = Math.ceil(kitchenPosts.length / perPage);

// First page articles
const firstPagePosts = kitchenPosts.slice(0, perPage);

const subcategories = [
  { 
    name: 'Pantry Organization', 
    slug: 'pantry', 
    icon: '🥫',
    description: 'Food storage, dry goods, and expiration date management' 
  },
  { 
    name: 'Fridge Storage', 
    slug: 'fridge', 
    icon: '❄️',
    description: 'Fridge zones, food preservation, and freezer organization' 
  },
  { 
    name: 'Cabinets & Counters', 
    slug: 'cabinets', 
    icon: '🍽️',
    description: 'Drawer dividers, cookware storage, and counter space reduction' 
  }
];
---

<BaseLayout 
  title="Kitchen Organization - Storage Ideas and Solutions" 
  description="Kitchen storage solutions: pantry organization, fridge zones, and cabinet organization. Real before-and-after photos from my own kitchen."
>
  <!-- Hero Section -->
  <section style="margin-bottom: 3rem;">
    <div style="background: linear-gradient(135deg, #fef3c7 0%, #fee2e2 100%); padding: 3rem 2rem; border-radius: 1rem; text-align: center;">
      <h1 style="color: #92400e; margin-bottom: 1rem;">🍳 Kitchen Organization</h1>
      <p style="color: #b45309; font-size: 1.1rem; max-width: 600px; margin: 0 auto; line-height: 1.8;">
        The kitchen is where the most chaos happens. Here's how I organized my pantry, fridge, and cabinets. The photos and measurements are all from my own kitchen.
      </p>
      {kitchenPosts.length > 0 && (
        <p style="color: #b45309; margin-top: 1rem; font-size: 0.95rem;">
          📚 {kitchenPosts.length} articles available
        </p>
      )}
    </div>
  </section>

  <!-- Subcategories Grid -->
  <section style="margin-bottom: 4rem;">
    <h2 style="text-align: center; margin-bottom: 2.5rem; font-size: 1.8rem;">Explore by Zone</h2>
    
    <div style="
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 2rem;
    ">
      {subcategories.map((sub) => (
        <a 
          href={`/kitchen/${sub.slug}/`}
          style="
            display: block;
            padding: 2rem;
            background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
            border: 2px solid var(--color-border);
            border-radius: 1rem;
            text-decoration: none;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
          "
          onmouseenter="this.style.borderColor='#f59e0b'; this.style.transform='translateY(-6px)'; this.style.boxShadow='0 20px 25px -5px rgba(0, 0, 0, 0.1)';"
          onmouseleave="this.style.borderColor='var(--color-border)'; this.style.transform='translateY(0)'; this.style.boxShadow='0 1px 2px 0 rgba(0, 0, 0, 0.05)';"
        >
          <div style="font-size: 2.5rem; margin-bottom: 1rem;">{sub.icon}</div>
          <h3 style="color: var(--color-text); margin: 0.5rem 0; font-size: 1.2rem;">{sub.name}</h3>
          <p style="color: var(--color-text-light); margin: 0; font-size: 0.95rem; line-height: 1.5;">
            {sub.description}
          </p>
        </a>
      ))}
    </div>
  </section>

  <!-- Latest Kitchen Articles -->
  {firstPagePosts.length > 0 && (
    <section style="margin-bottom: 4rem;">
  <HubIntro category="Kitchen" />

      <h2 style="margin-bottom: 2rem; font-size: 1.8rem;">Latest Articles</h2>
      
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
        {firstPagePosts.map((post, index) => (
          <div style={`animation-delay: ${index * 50}ms; animation: fadeInUp 0.6s ease-out forwards; opacity: 0;`}>
            <ArticleCard
              title={post.data.title}
              description={post.data.description}
              url={post.url}
              tags={post.data.tags}
              category={post.data.category}
              date={post.data.pubDate}
              readingTime={post.data.readingTime || 5}
            />
          </div>
        ))}
      </div>

      {totalPages > 1 && (
        <Pagination
          currentPage={1}
          totalPages={totalPages}
          baseUrl="/kitchen/"
        />
      )}
    </section>
  )}

  <!-- Info Section -->
  <section style="
    background: linear-gradient(135deg, #f0f9ff 0%, #f0fdf4 100%);
    padding: 3rem 2rem;
    border-radius: 1rem;
    border-left: 4px solid var(--color-primary);
    margin-bottom: 3rem;
  ">
    <h2 style="color: var(--color-primary); margin-top: 0; font-size: 1.5rem;">💡 Kitchen Organization Tips</h2>
    <ul style="color: var(--color-text-light); line-height: 1.8;">
      <li>Visibility is key - see what you have, use what you buy</li>
      <li>Zone your storage - keep similar items together</li>
      <li>Measure twice - know your shelf depths before buying organizers</li>
      <li>Test before buying - try systems at home first</li>
      <li>Label everything - especially for the freezer</li>
    </ul>
  </section>

  <style>
    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      :global(div[style*="animation"]) {
        animation: none !important;
      }
    }
  </style>
</BaseLayout>



