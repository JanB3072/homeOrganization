---
// Article layout optimized for SEO and social sharing

import BaseLayout from './BaseLayout.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

interface Props {
  title: string;
  description?: string;
  author?: string;
  pubDate?: Date;
  updatedDate?: Date;
  category?: string;
  subcategory?: string;
  tags?: string[];
  image?: string;
  breadcrumbs?: Array<{ name: string; path: string }>;
}

const { title, description, author, pubDate, updatedDate, category, subcategory, tags, image } = Astro.props;

// Format date for display
const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  }).format(date);
};

// Breadcrumb items
const breadcrumbs = [
  { name: 'Home', url: '/' },
  ...(category ? [{ name: category, url: `/${category.toLowerCase().replace(/\s+/g, '-')}/` }] : []),
  ...(subcategory ? [{ name: subcategory, url: '#' }] : []),
  { name: title, url: Astro.url.href },
];
---

<BaseLayout 
  title={title} 
  description={description}
  image={image}
  author={author}
>
  <!-- BlogPosting Schema -->
  <SchemaOrg 
    type="BlogPosting"
    title={title}
    description={description}
    image={image}
    datePublished={pubDate}
    dateModified={updatedDate}
    author={author}
    category={category}
    tags={tags}
  />
  
  <!-- Breadcrumb Navigation -->
  <Breadcrumbs items={breadcrumbs} />
  <article>
    {image && <img src={image} alt={title} />}
    
    <header>
      <h1>{title}</h1>
      
      <div class="post-meta">
        {pubDate && <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>}
        {category && <span class="category">{category}</span>}
      </div>
    </header>

    <div class="post-content">
      <slot />
    </div>

    {tags && tags.length > 0 && (
      <footer class="post-footer">
        <div class="tags">
          {tags.map(tag => (
            <a href={`/tags/${tag}/`} class="tag">{tag}</a>
          ))}
        </div>
        {updatedDate && (
          <p class="updated">
            Last updated: <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
          </p>
        )}
      </footer>
    )}
  </article>

  <style>
    article {
      max-width: 900px;
      margin: 0 auto;
    }

    img {
      margin: 2rem 0;
      border-radius: 8px;
    }

    .post-meta {
      display: flex;
      gap: 1rem;
      color: #666;
      font-size: 0.95rem;
      margin-bottom: 2rem;
    }

    .category {
      display: inline-block;
      background-color: #f0f0f0;
      padding: 0.25rem 0.75rem;
      border-radius: 20px;
      font-size: 0.85rem;
    }

    .post-content {
      font-size: 1.1rem;
      line-height: 1.8;
      margin: 2rem 0;
    }

    .post-footer {
      margin-top: 3rem;
      padding-top: 2rem;
      border-top: 1px solid #eee;
    }

    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 1rem;
    }

    .tag {
      display: inline-block;
      background-color: #f0f0f0;
      padding: 0.25rem 0.75rem;
      border-radius: 20px;
      font-size: 0.85rem;
      text-decoration: none;
    }

    .tag:hover {
      background-color: #e0e0e0;
      text-decoration: none;
    }

    .updated {
      font-size: 0.9rem;
      color: #666;
      margin: 0;
    }
  </style>
</BaseLayout>
