---
// Article layout optimized for SEO and social sharing

import BaseLayout from './BaseLayout.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import PostSidebar from '../components/PostSidebar.astro';
import { Image } from 'astro:assets';

interface Props {
  title: string;
  description?: string;
  author?: string;
  pubDate?: Date;
  updatedDate?: Date;
  category?: string;
  subcategory?: string;
  tags?: string[];
  image?: string;
  breadcrumbs?: Array<{ name: string; path: string }>;
  relatedPosts?: any[];
  currentSlug?: string;
}

const { title, description, author, pubDate, updatedDate, category, subcategory, tags, image, relatedPosts, currentSlug, takeaways, faq, howTo } = Astro.props;

// Format date for display
const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  }).format(date);
};
---

<BaseLayout 
  title={title} 
  description={description}
  image={image?.src}
  author={author}
  ogType="article"
  articleSection={category}
  articlePublished={pubDate?.toISOString()}
  articleModified={updatedDate?.toISOString() || pubDate?.toISOString()}
  articleTags={tags}
  wide
>
  <!-- BlogPosting Schema -->
  <SchemaOrg 
    type="BlogPosting"
    title={title}
    description={description}
    image={image?.src}
    datePublished={pubDate}
    dateModified={updatedDate}
    author={author}
    category={category}
    tags={tags}
    faq={faq}
    howTo={howTo}
  />
  
  <div class="post-container">
    <!-- Main Article Content -->
    <article class="post-main">
      {image && <Image src={image} alt={title} class="post-hero-image" />}
      
      <div class="article-header">
        <h1>{title}</h1>
        
        <div class="post-meta">
          {author && <span class="author">{author}</span>}
          {pubDate && <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>}
          {category && <span class="category">{category}</span>}
          {subcategory && <span class="subcategory">{subcategory}</span>}
        </div>
      </div>

      {takeaways && takeaways.length > 0 && (
        <aside class="key-takeaways" aria-label="Key takeaways">
          <h2>Key Takeaways</h2>
          <ul>
            {takeaways.map((point) => (
              <li>{point}</li>
            ))}
          </ul>
        </aside>
      )}

      <div class="post-content">
        <slot />
      </div>

      {faq && faq.length > 0 && (
        <section class="faq-section" aria-label="Frequently asked questions">
          <h2>Frequently Asked Questions</h2>
          {faq.map((item) => (
            <div class="faq-item">
              <h3>{item.question}</h3>
              <p>{item.answer}</p>
            </div>
          ))}
        </section>
      )}

      {tags && tags.length > 0 && (
        <footer class="post-footer">
          <div class="tags">
            {tags.map(tag => (
              <a href={`/tags/${tag}/`} class="tag">{tag}</a>
            ))}
          </div>
          {updatedDate && (
            <p class="updated">
              Last updated: <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
            </p>
          )}
        </footer>
      )}
    </article>

    <!-- Sidebar -->
    <PostSidebar 
      currentSlug={currentSlug}
      relatedPosts={relatedPosts}
      category={category}
      tags={tags}
    />
  </div>

  <style>
    .post-container {
      display: grid;
      grid-template-columns: 1fr 320px;
      gap: 2rem;
      max-width: 1200px;
      margin: 0.5rem auto 0;
    }

    .post-main {
      width: 100%;
    }

    .post-hero-image {
      width: 100%;
      margin: 2rem 0;
      border-radius: 12px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    }

    .article-header {
      margin-bottom: 0.5rem;
    }

    .article-header h1 {
      font-size: 2.5rem;
      font-weight: 700;
      line-height: 1.2;
      margin: 0 0 0.25rem 0;
      color: var(--color-text, #1f2937);
      letter-spacing: -0.02em;
    }

    .post-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      color: var(--color-text-light, #6b7280);
      font-size: 0.95rem;
      margin-bottom: 0.5rem;
    }

    .post-meta time {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .post-meta time::before {
      content: '📅';
    }

    .category,
    .subcategory,
    .author {
      display: inline-block;
      background-color: transparent;
      color: var(--color-text-light, #6b7280);
      padding: 0;
      border-radius: 0;
      font-size: 0.9rem;
      font-weight: 500;
      transition: all 0.2s ease;
      border-bottom: 2px solid var(--color-text-light, #6b7280);
    }

    .category:hover,
    .subcategory:hover {
      color: var(--color-text, #1f2937);
      border-bottom-color: var(--color-text, #1f2937);
    }

    .post-content {
      font-size: 1.1rem;
      line-height: 1.8;
      margin: 2rem 0;
      color: var(--color-text, #1f2937);
    }

    .post-content > * + * {
      margin-top: 1.5rem;
    }

    .post-footer {
      margin-top: 3rem;
      padding-top: 2rem;
      border-top: 1px solid var(--color-border, #e5e7eb);
    }

    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-bottom: 1rem;
    }

    .tag {
      display: inline-block;
      background: var(--color-bg-light, #f9fafb);
      color: var(--color-text, #1f2937);
      padding: 0.5rem 1rem;
      border-radius: 6px;
      font-size: 0.85rem;
      text-decoration: none;
      font-weight: 500;
      border: 1px solid var(--color-border, #e5e7eb);
      transition: all 0.2s ease;
    }

    .tag:hover {
      background: var(--color-primary, #3b82f6);
      color: white;
      border-color: var(--color-primary, #3b82f6);
      transform: translateY(-2px);
    }

    .updated {
      font-size: 0.9rem;
      color: var(--color-text-light, #6b7280);
      margin: 0;
    }

    /* Dark Mode */
    :global(.dark) header h1 {
      color: var(--color-text, #f3f4f6);
    }

    :global(.dark) .post-content {
      color: var(--color-text, #e5e7eb);
    }

    :global(.dark) .category,
    :global(.dark) .subcategory {
      background-color: rgba(59, 130, 246, 0.1);
      color: #60a5fa;
    }

    :global(.dark) .post-hero-image {
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    }

    /* Responsive */
    @media (max-width: 1024px) {
      .post-container {
        grid-template-columns: 1fr;
        gap: 1.5rem;
      }

      header h1 {
        font-size: 2rem;
      }

      .post-meta {
        gap: 0.75rem;
      }
    }

    @media (max-width: 640px) {
      header h1 {
        font-size: 1.5rem;
      }

      .post-meta {
        flex-direction: column;
        gap: 0.5rem;
      }

      .post-content {
        font-size: 1rem;
      }
    }
    /* Key Takeaways (GEO-optimized extractable summary) */
    .key-takeaways {
      background: var(--color-bg-light, #f9fafb);
      border: 1px solid var(--color-border, #e5e7eb);
      border-left: 4px solid var(--color-primary, #3b82f6);
      border-radius: var(--radius-md, 0.5rem);
      padding: 1.25rem 1.5rem;
      margin: 1.5rem 0 2rem;
    }

    .key-takeaways h2 {
      font-size: 1.3rem;
      margin: 0 0 0.75rem;
      color: var(--color-primary, #3b82f6);
    }

    .key-takeaways ul {
      margin: 0;
      padding-left: 1.25rem;
    }

    .key-takeaways li {
      margin-bottom: 0.4rem;
      color: var(--color-text, #1f2937);
    }

    /* FAQ section (PAA + generative engine citations) */
    .faq-section {
      margin-top: 3rem;
      padding-top: 2rem;
      border-top: 1px solid var(--color-border, #e5e7eb);
    }

    .faq-section h2 {
      font-size: 1.75rem;
      margin-bottom: 1.25rem;
    }

    .faq-item {
      margin-bottom: 1.5rem;
    }

    .faq-item h3 {
      font-size: 1.15rem;
      font-weight: 600;
      margin: 0 0 0.5rem;
      color: var(--color-text, #1f2937);
    }

    .faq-item p {
      margin: 0;
      color: var(--color-text-light, #6b7280);
    }

    :global(.dark) .key-takeaways {
      background: var(--color-bg-light, #1e293b);
    }
  </style>
</BaseLayout>
