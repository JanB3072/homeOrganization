---
import BaseLayout from './BaseLayout.astro';
import Pagination from '../components/Pagination.astro';
import type { BlogPost } from '../utils/content';

interface Props {
  category: string;
  subcategory: string;
  posts: BlogPost[];
  currentPage: number;
  totalPages: number;
}

const { category, subcategory, posts, currentPage, totalPages } = Astro.props;

const categorySlug = category.toLowerCase().replace(/\s+/g, '-');
const subcategorySlug = subcategory.toLowerCase().replace(/\s+/g, '-');
---

<BaseLayout 
  title={`${subcategory} - ${category} Organization | Home Organization Blog`}
  description={`Real ${category.toLowerCase()} organization tips focusing on ${subcategory.toLowerCase()}. See my before-and-after photos and step-by-step guides.`}
>
  <!-- Breadcrumbs -->
  <nav style="margin-bottom: 2rem; font-size: 0.95rem;">
    <a href="/" style="color: var(--color-primary);">Home</a>
    <span style="color: var(--color-text-light);">  /  </span>
    <a href={`/${categorySlug}/`} style="color: var(--color-primary);">{category}</a>
    <span style="color: var(--color-text-light);">  /  </span>
    <span style="color: var(--color-text);">{subcategory}</span>
  </nav>

  <!-- Header -->
  <section style="margin-bottom: 3rem;">
    <h1 style="margin-bottom: 0.5rem;">{subcategory}</h1>
    <p style="color: var(--color-text-light); font-size: 1.05rem; margin: 0;">
      {posts.length} of {totalPages * 12} articles about {subcategory}
    </p>
  </section>

  <!-- Articles Grid -->
  {posts.length > 0 ? (
    <section>
      <div style="
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1.5rem;
        margin-bottom: 3rem;
      ">
        {posts.map(post => (
          <article style="
            padding: 1.5rem;
            background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
            border: 1px solid var(--color-border);
            border-radius: 0.75rem;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
          "
          onmouseenter="this.style.borderColor='var(--color-primary)'; this.style.boxShadow='0 10px 15px -3px rgba(0, 0, 0, 0.1)';"
          onmouseleave="this.style.borderColor='var(--color-border)'; this.style.boxShadow='0 1px 2px 0 rgba(0, 0, 0, 0.05)';">
            <a href={`/blog/${post.slug}/`} style="text-decoration: none; color: inherit;">
              <h2 style="margin: 0 0 0.5rem 0; font-size: 1.25rem; color: var(--color-text);">
                {post.data.title}
              </h2>
            </a>
            <p style="color: var(--color-text-light); margin: 0.5rem 0 1rem 0; line-height: 1.6;">
              {post.data.description}
            </p>
            <div style="display: flex; gap: 1.5rem; flex-wrap: wrap; font-size: 0.9rem; color: var(--color-text-light);">
              <span>📅 {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
              {post.data.tags.slice(0, 2).map(tag => (
                <a href={`/tags/${tag}/`} style="color: var(--color-primary); text-decoration: none;">
                  #{tag}
                </a>
              ))}
              <a href={`/blog/${post.slug}/`} style="color: var(--color-primary); font-weight: 500; margin-left: auto;">
                Read More →
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- Pagination -->
      {totalPages > 1 && (
        <Pagination 
          currentPage={currentPage}
          totalPages={totalPages}
          baseUrl={`/${categorySlug}/${subcategorySlug}/`}
        />
      )}
    </section>
  ) : (
    <div style="
      padding: 3rem 2rem;
      text-align: center;
      background: var(--color-bg-light);
      border-radius: 0.75rem;
      border: 1px dashed var(--color-border);
    ">
      <p style="margin: 0; color: var(--color-text-light); font-size: 1.05rem;">
        No articles found in this category yet. Check back soon!
      </p>
    </div>
  )}
</BaseLayout>
